generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  client
  admin
}

enum DominantMacro {
  protein
  carbs
  fat
  protein_fat
  protein_carbs
}

enum FoodSource {
  openfoodfacts
  custom
  harbiz
}

model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String       @unique
  name         String?
  role         UserRole     @default(client)
  isActive     Boolean      @default(true) @map("is_active")
  invitedById  String?      @map("invited_by") @db.Uuid
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedUsers User[]       @relation("InvitedBy")
  invitations  Invitation[] @relation("InvitedByAdmin")
  harbizEmail  String?      @map("harbiz_email")
  createdFoods Food[]
  diaryLogs    DiaryLog[]
  userMeals    UserMeal[]
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("users")
}

model UserMeal {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  user          User       @relation(fields: [userId], references: [id])
  name          String
  order         Int
  targetKcal    Decimal?   @db.Decimal(8, 1) @map("target_kcal")
  targetProtein Decimal?   @db.Decimal(8, 2) @map("target_protein")
  targetCarbs   Decimal?   @db.Decimal(8, 2) @map("target_carbs")
  targetFat     Decimal?   @db.Decimal(8, 2) @map("target_fat")
  diaryLogs     DiaryLog[]
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([userId, order])
  @@map("user_meals")
}

model Invitation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token       String    @unique
  email       String
  invitedById String    @map("invited_by") @db.Uuid
  invitedBy   User      @relation("InvitedByAdmin", fields: [invitedById], references: [id])
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("invitations")
}

model Food {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  brand         String?
  category      String?
  calories      Decimal       @db.Decimal(8, 2)
  protein       Decimal       @db.Decimal(8, 2)
  carbs         Decimal       @db.Decimal(8, 2)
  fat           Decimal       @db.Decimal(8, 2)
  fiber         Decimal?      @db.Decimal(8, 2)
  dominantMacro DominantMacro @map("dominant_macro")
  source        FoodSource    @default(openfoodfacts)
  offId         String?       @unique @map("off_id")
  isActive      Boolean       @default(true) @map("is_active")
  createdById   String?       @map("created_by") @db.Uuid
  createdBy     User?         @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  diaryLogs     DiaryLog[]

  @@index([dominantMacro, isActive])
  @@index([name])
  @@map("foods")
}

model DiaryLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime @db.Date
  userMealId String   @map("user_meal_id") @db.Uuid
  userMeal   UserMeal @relation(fields: [userMealId], references: [id], onDelete: Cascade)
  foodId     String   @map("food_id") @db.Uuid
  food       Food     @relation(fields: [foodId], references: [id])
  grams      Decimal  @db.Decimal(8, 1)
  kcal       Decimal  @db.Decimal(8, 1)
  protein    Decimal  @db.Decimal(8, 2)
  carbs      Decimal  @db.Decimal(8, 2)
  fat        Decimal  @db.Decimal(8, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, date])
  @@index([userMealId])
  @@map("diary_logs")
}
